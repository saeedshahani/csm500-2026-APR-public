              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact saved JSON bytes; X-Content-SHA256 equals document_sha256",
            "headers": {
              "X-Content-SHA256": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; project access is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job}/events": {
      "get": {
        "operationId": "eventPage",
        "description": "Page from the hash-verified published trace, not a standalone replayable trace. Response capped at 1 MiB; 413 asks for a smaller page. Whole stored trace remains capped at 16 MiB.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "total",
                    "next_offset"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "schema": {
                      "const": "reflective-event-page-v1"
                    },
                    "trace_sha256": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Structured error; project access is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job}/report": {
      "get": {
        "operationId": "runReport",
        "description": "Descriptive before/after carrier counts, including quoted syntax; not graph equivalence or convergence. Requires a verified result.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema",
                    "trace_sha256",
                    "initial",
                    "final",
                    "commits",
                    "limitation"
                  ],
                  "properties": {
                    "schema": {
                      "const": "reflective-run-summary-v1"
                    },
                    "trace_sha256": {
                      "type": "string"
                    },
                    "initial": {
                      "type": "object"
                    },
                    "final": {
                      "type": "object"
                    },
                    "commits": {
                      "type": "integer"
                    },
                    "limitation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Structured error; project access is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only accepted when configured for local-single-owner mode."
      },
      "EmulatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase emulator ID token; only accepted in explicit firebase-emulator mode. Development tokens are unsigned and are not production credentials."
      }
    },
    "schemas": {
      "Members": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_uid",
          "members"
        ],
        "properties": {
          "owner_uid": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uid",
                "role"
              ],
              "properties": {
                "uid": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "viewer",
                    "editor"
                  ]
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 100
          },
          "max_work": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "default": 1000000
          },
          "max_candidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 1000
          },
          "deadline_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 10000
          },
          "seed": {
            "type": [
              "string",
              "null"
            ],
            "description": "Decimal u64 string up to 18446744073709551615"
          },
          "detect_cycles": {
            "type": "boolean",
            "default": false
          }
        },
        "required": []
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_uid": {
            "type": "string",
            "description": "Emulator mode only"
          },
          "role": {
            "enum": [
              "owner",
              "editor",
              "viewer"
            ],
            "description": "Requester's project role in emulator mode"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          },
          "validated_engine_sha256": {
            "type": "string"
          },
          "parent_version_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent in older stores; absence and null mean no parent."
          },
          "created_at": {
            "type": "string"
          },
          "dataset_id": {
            "type": "string",
            "description": "Present only for a version compiled from this immutable dataset; source digest must match."
          }
        },
        "required": [
          "id",
          "project_id",
          "name",
          "source_sha256",
          "validated_engine_sha256",
          "created_at"
        ]
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "version_id",
          "settings",
          "status",
          "outcome",
          "trace_sha256",
          "engine_sha256",
          "source_sha256"
        ],
        "properties": {
          "submitted_by": {
            "type": "string",
            "description": "Emulator UID; idempotency is scoped to this submitter and project"
          },
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "parent_job_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent in older stores; absence and null mean no parent."
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "cancelled",
              "timed_out",
              "failed",
              "interrupted"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "Engine outcome of verified trace, not synonymous with platform completion."
          },
          "trace_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "commits": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source_sha256": {
            "type": "string"
          },
          "engine_sha256": {
            "type": "string"
          },
          "request_sha256": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "implementation": {
            "type": "string"
          },
          "cancellation_requested_at": {
            "type": "string"
          }
        }
      },
      "Dataset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "name",
          "schema",
          "document_sha256",
          "source_sha256",
          "validated_engine_sha256",
          "created_at",
          "items",
          "parent_dataset_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "document_sha256": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          },
          "validated_engine_sha256": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "parent_dataset_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
