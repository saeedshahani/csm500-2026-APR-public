{
  "openapi": "3.1.0",
  "info": {
    "title": "Reflective Graph Local Developer API",
    "version": "0.1.0",
    "description": "Loopback developer API using either a local owner token or Firebase Authentication emulator identities with project roles. Not a hosted or production-authenticated service. Delegates semantics to the pinned Rust CLI."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "LocalBearer": []
    },
    {
      "EmulatorBearer": []
    }
  ],
  "paths": {
    "/v1/projects/{project}/members": {
      "get": {
        "operationId": "members",
        "description": "Emulator mode only. Requires project owner; no membership list is exposed to editors or viewers.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          },
          "default": {
            "description": "401 identity rejected; 403 not owner; 404 inaccessible or unsupported in local-token mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "setMember",
        "description": "Emulator mode only. Owner grants or changes viewer/editor membership; null removes membership. The owner cannot be changed. Maximum 32 members.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uid",
                  "role"
                ],
                "properties": {
                  "uid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "role": {
                    "enum": [
                      "viewer",
                      "editor",
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Members"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; invalid membership, missing access or capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "api": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "uid": {
                      "type": "string",
                      "description": "Authenticated UID in emulator mode"
                    },
                    "project_id": {
                      "type": "string",
                      "description": "Firebase demo project in emulator mode"
                    },
                    "engine_sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "api",
                    "mode",
                    "engine_sha256"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/validate": {
      "post": {
        "operationId": "validate",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "valid": {
                      "const": true
                    },
                    "source_sha256": {
                      "type": "string"
                    },
                    "engine_sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "valid",
                    "source_sha256",
                    "engine_sha256"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "post": {
        "operationId": "createProject",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "next_offset"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/versions": {
      "post": {
        "operationId": "createVersion",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "description": "Well-formed text, at most 262144 UTF-8 bytes"
                  },
                  "parent_version_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Optional existing version in the same project; a fork is a new immutable source, not a graph rewrite."
                  },
                  "dataset_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "oneOf": [
                  {
                    "required": [
                      "source"
                    ],
                    "not": {
                      "required": [
                        "dataset_id"
                      ]
                    }
                  },
                  {
                    "required": [
                      "dataset_id"
                    ],
                    "not": {
                      "required": [
                        "source"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listVersions",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Version"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "next_offset"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/jobs": {
      "get": {
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "next_offset"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitJob",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing idempotent request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "202": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; limits and codes described in README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "version_id": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "parent_job_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Optional terminal job in the same project. Included in request identity. New execution, not continuation."
                  },
                  "settings": {
                    "$ref": "#/components/schemas/Settings"
                  }
                },
                "required": [
                  "version_id",
                  "idempotency_key"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job}": {
      "get": {
        "operationId": "getJob",
