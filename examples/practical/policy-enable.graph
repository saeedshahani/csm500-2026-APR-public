atom status_4 = Record[ObjectLink]("pending", item_4, item_4);
atom item_5 = Constructor("WorkItem:work-0008");
atom status_5 = Record[ObjectLink]("pending", item_5, item_5);
atom item_6 = Constructor("WorkItem:work-0001");
atom status_6 = Record[ObjectLink]("pending", item_6, item_6);
atom item_7 = Constructor("WorkItem:work-0009");
atom status_7 = Record[ObjectLink]("pending", item_7, item_7);
atom item_8 = Constructor("WorkItem:work-0007");
atom status_8 = Record[ObjectLink]("pending", item_8, item_8);
atom item_9 = Constructor("WorkItem:work-0003");
