// A single transaction removes an inactive rule package, not just its body.
program {
 rule retire {
  atom z = Nat(); atom one = Nat(z);
  rank r = one; mode m = ModeMeta; revision rev; active enabled;
  atom h = PatternVariable[RuleHead] Free;
  atom n = Nat(); atom hr = Record[Rank](h,n);
  atom hm = Record[ModeObject](h); atom hv = Record[Revision](h);
  lhs {lh:h; ln:n; lr:hr; lm:hm; lv:hv;}
  rhs {}
 }
 atom child = RuleHead; atom cz = Nat();
 atom cr = Record[Rank](child,cz);
 atom cm = Record[ModeObject](child); atom cv = Record[Revision](child);
}
