// Two nonrenewable visible credits permit two fresh inactive rule packages.
program {
 rule factory {
  atom z = Nat(); atom one = Nat(z);
  rank r = one; mode m = ModeMeta; revision rev; active enabled;
  atom credit = Constructor("MetaCredit");
  atom child = RuleHead;
  atom cz = Nat(); atom cr = Record[Rank](child, cz);
  atom cm = Record[ModeObject](child); atom cv = Record[Revision](child);
  lhs { lc: credit; }
  rhs { rh: child; rz: cz; rr: cr; rm: cm; rv: cv; }
 }
 atom permit_a = Constructor("MetaCredit");
 atom permit_b = Constructor("MetaCredit");
}
