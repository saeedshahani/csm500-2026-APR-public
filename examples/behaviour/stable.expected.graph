// Hand-derived after one step: only pending is replaced by done.
program {
  rule settle {
    atom z = Nat();
    rank r = z;
    mode m = ModeObject;
    revision v;
    active active_settle;
    atom x = PatternVariable[Constructor] Free;
    atom y = PatternVariable[Constructor] Free;
    atom old = Record[ObjectLink]("pending", x, y);
    atom new = Record[ObjectLink]("done", x, y);
    lhs { lx: x; ly: y; ll: old; }
    rhs { rx: x; ry: y; rl: new; }
  }
  atom a = Constructor("A");
  atom b = Constructor("B");
  atom value = Record[ObjectLink]("value", a, b);
  atom phase = Record[ObjectLink]("done", a, b);
}
