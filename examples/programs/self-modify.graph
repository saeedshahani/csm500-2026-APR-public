// SelfLower also replaces its A output template with B; supervisor restores its rank.
program {
    atom sl = RuleHead;
    atom sl_r0 = Nat();
    atom sl_r1 = Nat(sl_r0);
    atom sl_active = Record[Active](sl);
    atom sl_mode = Record[ModeMeta](sl);
    atom sl_rank = Record[Rank](sl, sl_r1);
    atom sl_revision = Record[Revision](sl);
    atom b_self = PatternVariable[RuleHead] AppliedRule;
    atom b_rest = PatternVariable[Nat] Free;
    atom b_top = Nat(b_rest);
    atom b_old_rank = Record[Rank](b_self, b_top);
    atom b_old_rev = Record[Revision](b_self);
    atom b_new_rank = Record[Rank](b_self, b_rest);
    atom b_new_rev = Record[Revision](b_self);
    atom sl_L_self = Record[Lhs](sl, b_self);
    atom sl_L_rest = Record[Lhs](sl, b_rest);
    atom sl_L_top = Record[Lhs](sl, b_top);
    atom sl_L_rank = Record[Lhs](sl, b_old_rank);
    atom sl_L_rev = Record[Lhs](sl, b_old_rev);
    atom sl_R_self = Record[Rhs](sl, b_self);
    atom sl_R_rest = Record[Rhs](sl, b_rest);
    atom sl_R_rank = Record[Rhs](sl, b_new_rank);
    atom sl_R_rev = Record[Rhs](sl, b_new_rev);
    atom output_a = Constructor("A");
    atom output_var = PatternVariable[Constructor] Free;
    atom old_output_member = Record[Rhs](b_self, output_var);
    atom replacement_b = Constructor("B");
    atom new_output_member = Record[Rhs](b_self, replacement_b);
    atom sl_L_output_var = Record[Lhs](sl, output_var);
    atom sl_L_old_output_member = Record[Lhs](sl, old_output_member);
    atom sl_R_output_var = Record[Rhs](sl, output_var);
    atom sl_R_output_a = Record[Rhs](sl, output_a);
    atom sl_R_replacement_b = Record[Rhs](sl, replacement_b);
    atom sl_R_new_output_member = Record[Rhs](sl, new_output_member);
    atom supervisor = RuleHead;
    atom supervisor_r0 = Nat();
    atom supervisor_r1 = Nat(supervisor_r0);
    atom supervisor_r2 = Nat(supervisor_r1);
    atom supervisor_rank = Record[Rank](supervisor, supervisor_r2);
    atom supervisor_revision = Record[Revision](supervisor);
    atom supervisor_mode = Record[ModeMeta](supervisor);
    atom supervisor_active = Record[Active](supervisor);
    atom sup_h = PatternVariable[RuleHead] Free;
    atom sup_zero = Nat();
    atom sup_old_rank = Record[Rank](sup_h, sup_zero);
    atom sup_old_revision = Record[Revision](sup_h);
    atom sup_one = Nat(sup_zero);
    atom sup_new_rank = Record[Rank](sup_h, sup_one);
    atom sup_new_revision = Record[Revision](sup_h);
    atom supervisor_L_sup_h = Record[Lhs](supervisor, sup_h);
    atom supervisor_L_sup_zero = Record[Lhs](supervisor, sup_zero);
    atom supervisor_L_sup_old_rank = Record[Lhs](supervisor, sup_old_rank);
    atom supervisor_L_sup_old_revision = Record[Lhs](supervisor, sup_old_revision);
    atom supervisor_R_sup_h = Record[Rhs](supervisor, sup_h);
    atom supervisor_R_sup_zero = Record[Rhs](supervisor, sup_zero);
    atom supervisor_R_sup_one = Record[Rhs](supervisor, sup_one);
    atom supervisor_R_sup_new_rank = Record[Rhs](supervisor, sup_new_rank);
    atom supervisor_R_sup_new_revision = Record[Rhs](supervisor, sup_new_revision);
}
