// Hand-derived after one P/supervisor/Q/supervisor round: same complete carrier up to identity renaming; revisions are fresh.
program {
    atom p = RuleHead;
    atom p_r0 = Nat();
    atom p_r1 = Nat(p_r0);
    atom p_rank = Record[Rank](p, p_r1);
    atom p_revision = Record[Revision](p);
    atom p_mode = Record[ModeMeta](p);
    atom p_active = Record[Active](p);
    atom p_h = PatternVariable[RuleHead] Free;
    atom p_zero = Nat();
    atom p_one = Nat(p_zero);
    atom p_old_rank = Record[Rank](p_h, p_one);
    atom p_old_revision = Record[Revision](p_h);
    atom p_note = Constructor("NoteByP");
    atom p_note_l = Record[Lhs](p_h, p_note);
    atom p_note_r = Record[Rhs](p_h, p_note);
    atom p_own = Constructor("NoteByQ");
    atom p_fresh = Constructor("NoteByP");
    atom p_fresh_l = Record[Lhs](p_h, p_fresh);
    atom p_fresh_r = Record[Rhs](p_h, p_fresh);
    atom p_new_rank = Record[Rank](p_h, p_zero);
    atom p_new_revision = Record[Revision](p_h);
    atom p_L_p_h = Record[Lhs](p, p_h);
    atom p_L_p_zero = Record[Lhs](p, p_zero);
    atom p_L_p_one = Record[Lhs](p, p_one);
    atom p_L_p_old_rank = Record[Lhs](p, p_old_rank);
    atom p_L_p_old_revision = Record[Lhs](p, p_old_revision);
    atom p_L_p_note = Record[Lhs](p, p_note);
    atom p_L_p_note_l = Record[Lhs](p, p_note_l);
    atom p_L_p_note_r = Record[Lhs](p, p_note_r);
    atom p_L_p_own = Record[Lhs](p, p_own);
    atom p_R_p_h = Record[Rhs](p, p_h);
    atom p_R_p_zero = Record[Rhs](p, p_zero);
    atom p_R_p_own = Record[Rhs](p, p_own);
    atom p_R_p_fresh = Record[Rhs](p, p_fresh);
    atom p_R_p_fresh_l = Record[Rhs](p, p_fresh_l);
    atom p_R_p_fresh_r = Record[Rhs](p, p_fresh_r);
    atom p_R_p_new_rank = Record[Rhs](p, p_new_rank);
    atom p_R_p_new_revision = Record[Rhs](p, p_new_revision);
    atom q = RuleHead;
    atom q_r0 = Nat();
    atom q_r1 = Nat(q_r0);
    atom q_rank = Record[Rank](q, q_r1);
    atom q_revision = Record[Revision](q);
    atom q_mode = Record[ModeMeta](q);
    atom q_active = Record[Active](q);
    atom q_h = PatternVariable[RuleHead] Free;
    atom q_zero = Nat();
    atom q_one = Nat(q_zero);
    atom q_old_rank = Record[Rank](q_h, q_one);
    atom q_old_revision = Record[Revision](q_h);
    atom q_note = Constructor("NoteByQ");
    atom q_note_l = Record[Lhs](q_h, q_note);
    atom q_note_r = Record[Rhs](q_h, q_note);
    atom q_own = Constructor("NoteByP");
    atom q_fresh = Constructor("NoteByQ");
    atom q_fresh_l = Record[Lhs](q_h, q_fresh);
    atom q_fresh_r = Record[Rhs](q_h, q_fresh);
    atom q_new_rank = Record[Rank](q_h, q_zero);
    atom q_new_revision = Record[Revision](q_h);
    atom q_L_q_h = Record[Lhs](q, q_h);
    atom q_L_q_zero = Record[Lhs](q, q_zero);
    atom q_L_q_one = Record[Lhs](q, q_one);
    atom q_L_q_old_rank = Record[Lhs](q, q_old_rank);
    atom q_L_q_old_revision = Record[Lhs](q, q_old_revision);
    atom q_L_q_note = Record[Lhs](q, q_note);
    atom q_L_q_note_l = Record[Lhs](q, q_note_l);
    atom q_L_q_note_r = Record[Lhs](q, q_note_r);
    atom q_L_q_own = Record[Lhs](q, q_own);
    atom q_R_q_h = Record[Rhs](q, q_h);
    atom q_R_q_zero = Record[Rhs](q, q_zero);
    atom q_R_q_own = Record[Rhs](q, q_own);
    atom q_R_q_fresh = Record[Rhs](q, q_fresh);
    atom q_R_q_fresh_l = Record[Rhs](q, q_fresh_l);
    atom q_R_q_fresh_r = Record[Rhs](q, q_fresh_r);
    atom q_R_q_new_rank = Record[Rhs](q, q_new_rank);
    atom q_R_q_new_revision = Record[Rhs](q, q_new_revision);
    atom supervisor = RuleHead;
    atom supervisor_r0 = Nat();
    atom supervisor_r1 = Nat(supervisor_r0);
    atom supervisor_r2 = Nat(supervisor_r1);
    atom supervisor_rank = Record[Rank](supervisor, supervisor_r2);
    atom supervisor_revision = Record[Revision](supervisor);
    atom supervisor_mode = Record[ModeMeta](supervisor);
    atom supervisor_active = Record[Active](supervisor);
    atom sup_h = PatternVariable[RuleHead] Free;
    atom sup_zero = Nat();
    atom sup_old_rank = Record[Rank](sup_h, sup_zero);
    atom sup_old_revision = Record[Revision](sup_h);
    atom sup_one = Nat(sup_zero);
    atom sup_new_rank = Record[Rank](sup_h, sup_one);
    atom sup_new_revision = Record[Revision](sup_h);
    atom supervisor_L_sup_h = Record[Lhs](supervisor, sup_h);
    atom supervisor_L_sup_zero = Record[Lhs](supervisor, sup_zero);
    atom supervisor_L_sup_old_rank = Record[Lhs](supervisor, sup_old_rank);
    atom supervisor_L_sup_old_revision = Record[Lhs](supervisor, sup_old_revision);
    atom supervisor_R_sup_h = Record[Rhs](supervisor, sup_h);
    atom supervisor_R_sup_zero = Record[Rhs](supervisor, sup_zero);
    atom supervisor_R_sup_one = Record[Rhs](supervisor, sup_one);
    atom supervisor_R_sup_new_rank = Record[Rhs](supervisor, sup_new_rank);
    atom supervisor_R_sup_new_revision = Record[Rhs](supervisor, sup_new_revision);
}
