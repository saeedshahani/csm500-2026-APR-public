// C1: exchanging ranks violates strict post-rank < source pre-rank. Expected state is this unchanged input.
program {
    atom p = RuleHead;
    atom p_r0 = Nat();
    atom p_r1 = Nat(p_r0);
    atom p_active = Record[Active](p);
    atom p_mode = Record[ModeMeta](p);
    atom p_rank = Record[Rank](p, p_r1);
    atom p_revision = Record[Revision](p);
    atom p_self = PatternVariable[RuleHead] AppliedRule;
    atom p_other = PatternVariable[RuleHead] Free;
    atom p_self_zero = Nat();
    atom p_self_one = Nat(p_self_zero);
    atom p_other_zero = Nat();
    atom p_self_rank = Record[Rank](p_self, p_self_one);
    atom p_other_rank = Record[Rank](p_other, p_other_zero);
    atom p_self_rev = Record[Revision](p_self);
    atom p_other_rev = Record[Revision](p_other);
    atom p_tag = Constructor("PTag");
    atom p_new_self_rank = Record[Rank](p_self, p_other_zero);
    atom p_new_other_rank = Record[Rank](p_other, p_self_one);
    atom p_new_self_rev = Record[Revision](p_self);
    atom p_new_other_rev = Record[Revision](p_other);
    atom p_L_self = Record[Lhs](p, p_self);
    atom p_L_other = Record[Lhs](p, p_other);
    atom p_L_self_zero = Record[Lhs](p, p_self_zero);
    atom p_L_self_one = Record[Lhs](p, p_self_one);
    atom p_L_other_zero = Record[Lhs](p, p_other_zero);
    atom p_L_self_rank = Record[Lhs](p, p_self_rank);
    atom p_L_other_rank = Record[Lhs](p, p_other_rank);
    atom p_L_self_rev = Record[Lhs](p, p_self_rev);
    atom p_L_other_rev = Record[Lhs](p, p_other_rev);
    atom p_L_tag = Record[Lhs](p, p_tag);
    atom p_R_self = Record[Rhs](p, p_self);
    atom p_R_other = Record[Rhs](p, p_other);
    atom p_R_self_zero = Record[Rhs](p, p_self_zero);
    atom p_R_self_one = Record[Rhs](p, p_self_one);
    atom p_R_other_zero = Record[Rhs](p, p_other_zero);
    atom p_R_tag = Record[Rhs](p, p_tag);
    atom p_R_new_self_rank = Record[Rhs](p, p_new_self_rank);
    atom p_R_new_other_rank = Record[Rhs](p, p_new_other_rank);
    atom p_R_new_self_rev = Record[Rhs](p, p_new_self_rev);
    atom p_R_new_other_rev = Record[Rhs](p, p_new_other_rev);
    atom q = RuleHead;
    atom q_r0 = Nat();
    atom q_active = Record[Active](q);
    atom q_mode = Record[ModeMeta](q);
    atom q_rank = Record[Rank](q, q_r0);
    atom q_revision = Record[Revision](q);
    atom q_self = PatternVariable[RuleHead] AppliedRule;
    atom q_other = PatternVariable[RuleHead] Free;
    atom q_self_zero = Nat();
    atom q_self_one = Nat(q_self_zero);
    atom q_other_zero = Nat();
    atom q_self_rank = Record[Rank](q_self, q_self_one);
    atom q_other_rank = Record[Rank](q_other, q_other_zero);
    atom q_self_rev = Record[Revision](q_self);
    atom q_other_rev = Record[Revision](q_other);
    atom q_tag = Constructor("QTag");
    atom q_new_self_rank = Record[Rank](q_self, q_other_zero);
    atom q_new_other_rank = Record[Rank](q_other, q_self_one);
    atom q_new_self_rev = Record[Revision](q_self);
    atom q_new_other_rev = Record[Revision](q_other);
    atom q_L_self = Record[Lhs](q, q_self);
    atom q_L_other = Record[Lhs](q, q_other);
    atom q_L_self_zero = Record[Lhs](q, q_self_zero);
    atom q_L_self_one = Record[Lhs](q, q_self_one);
    atom q_L_other_zero = Record[Lhs](q, q_other_zero);
    atom q_L_self_rank = Record[Lhs](q, q_self_rank);
    atom q_L_other_rank = Record[Lhs](q, q_other_rank);
    atom q_L_self_rev = Record[Lhs](q, q_self_rev);
    atom q_L_other_rev = Record[Lhs](q, q_other_rev);
    atom q_L_tag = Record[Lhs](q, q_tag);
    atom q_R_self = Record[Rhs](q, q_self);
    atom q_R_other = Record[Rhs](q, q_other);
    atom q_R_self_zero = Record[Rhs](q, q_self_zero);
    atom q_R_self_one = Record[Rhs](q, q_self_one);
    atom q_R_other_zero = Record[Rhs](q, q_other_zero);
    atom q_R_tag = Record[Rhs](q, q_tag);
    atom q_R_new_self_rank = Record[Rhs](q, q_new_self_rank);
    atom q_R_new_other_rank = Record[Rhs](q, q_new_other_rank);
    atom q_R_new_self_rev = Record[Rhs](q, q_new_self_rev);
    atom q_R_new_other_rev = Record[Rhs](q, q_new_other_rev);
}
