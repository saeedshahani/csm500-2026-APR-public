// Hand-derived installation: copy 13 quoted atoms with private variable and fresh head/revision.
program {
    atom iw = RuleHead;
    atom iw_r0 = Nat();
    atom iw_r1 = Nat(iw_r0);
    atom iw_active = Record[Active](iw);
    atom iw_mode = Record[ModeMeta](iw);
    atom iw_rank = Record[Rank](iw, iw_r1);
    atom iw_revision = Record[Revision](iw);
    atom wh = RuleHead;
    atom wr0 = Nat();
    atom wrank = Record[Rank](wh, wr0);
    atom wmode = Record[ModeObject](wh);
    atom wactive = Record[Active](wh);
    atom wrev = Record[Revision](wh);
    atom x = PatternVariable[Constructor] Free;
    atom box = Constructor("Wrapped");
    atom child = Record[ObjectLink]("child", box, x);
    atom wl_x = Record[Lhs](wh, x);
    atom wr_x = Record[Rhs](wh, x);
    atom wr_box = Record[Rhs](wh, box);
    atom wr_child = Record[Rhs](wh, child);
    atom iw_R_wh = Record[Rhs](iw, wh);
    atom iw_R_wr0 = Record[Rhs](iw, wr0);
    atom iw_R_wrank = Record[Rhs](iw, wrank);
    atom iw_R_wmode = Record[Rhs](iw, wmode);
    atom iw_R_wactive = Record[Rhs](iw, wactive);
    atom iw_R_wrev = Record[Rhs](iw, wrev);
    atom iw_R_x = Record[Rhs](iw, x);
    atom iw_R_box = Record[Rhs](iw, box);
    atom iw_R_child = Record[Rhs](iw, child);
    atom iw_R_wl_x = Record[Rhs](iw, wl_x);
    atom iw_R_wr_x = Record[Rhs](iw, wr_x);
    atom iw_R_wr_box = Record[Rhs](iw, wr_box);
    atom iw_R_wr_child = Record[Rhs](iw, wr_child);
    atom input = Constructor("Payload");
    atom installed_wh = RuleHead;
    atom installed_wr0 = Nat();
    atom installed_wrank = Record[Rank](installed_wh, installed_wr0);
    atom installed_wmode = Record[ModeObject](installed_wh);
    atom installed_wactive = Record[Active](installed_wh);
    atom installed_wrev = Record[Revision](installed_wh);
    atom installed_x = PatternVariable[Constructor] Free;
    atom installed_box = Constructor("Wrapped");
    atom installed_child = Record[ObjectLink]("child", installed_box, installed_x);
    atom installed_wl_x = Record[Lhs](installed_wh, installed_x);
    atom installed_wr_x = Record[Rhs](installed_wh, installed_x);
    atom installed_wr_box = Record[Rhs](installed_wh, installed_box);
    atom installed_wr_child = Record[Rhs](installed_wh, installed_child);
}
