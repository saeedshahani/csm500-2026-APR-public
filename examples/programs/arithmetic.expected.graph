// Hand-derived: consume Add, Zero and three links; retain Eval and Value; add expr.
program {
    atom az = RuleHead;
    atom az_r0 = Nat();
    atom az_active = Record[Active](az);
    atom az_mode = Record[ModeObject](az);
    atom az_rank = Record[Rank](az, az_r0);
    atom az_revision = Record[Revision](az);
    atom t_ev = Constructor("Eval");
    atom t_a = Constructor("Add");
    atom t_z = Constructor("Zero");
    atom t_y = PatternVariable[Constructor] Free;
    atom t_e0 = Record[ObjectLink]("expr", t_ev, t_a);
    atom t_e1 = Record[ObjectLink]("arg1", t_a, t_z);
    atom t_e2 = Record[ObjectLink]("arg2", t_a, t_y);
    atom t_e3 = Record[ObjectLink]("expr", t_ev, t_y);
    atom az_L_ev = Record[Lhs](az, t_ev);
    atom az_L_a = Record[Lhs](az, t_a);
    atom az_L_z = Record[Lhs](az, t_z);
    atom az_L_y = Record[Lhs](az, t_y);
    atom az_L_e0 = Record[Lhs](az, t_e0);
    atom az_L_e1 = Record[Lhs](az, t_e1);
    atom az_L_e2 = Record[Lhs](az, t_e2);
    atom az_R_ev = Record[Rhs](az, t_ev);
    atom az_R_y = Record[Rhs](az, t_y);
    atom az_R_e3 = Record[Rhs](az, t_e3);
    atom h_ev = Constructor("Eval");
    atom h_y = Constructor("Value");
    atom result_expr = Record[ObjectLink]("expr", h_ev, h_y);
}
