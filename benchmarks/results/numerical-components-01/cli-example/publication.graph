program {
rule publish {
atom publish_zero = Nat(); rank publish_rank = publish_zero;
mode publish_mode = ModeObject; revision publish_version; active publish_enabled;
atom publish_p = Constructor("T2Component");
atom publish_v = PatternVariable[Constructor] Free;
atom publish_pending = Record[ObjectLink]("pending",publish_p,publish_v);
atom publish_done = Record[ObjectLink]("certified",publish_p,publish_v);
lhs { publish_lhs0: publish_p; publish_lhs1: publish_v; publish_lhs2: publish_pending; } rhs { publish_rhs0: publish_p; publish_rhs1: publish_v; publish_rhs2: publish_done; }
}
atom component = Constructor("T2Component");
atom value = Constructor("{\"assumptions\":[\"complete sampled input stream\",\"protected task and host checker\",\"serialized host calls\",\"logical clock\",\"checked native CLI\"],\"checked_at\":0,\"current\":{\"active\":true,\"boundary\":\"3/8\",\"epoch\":0,\"fault\":null,\"revision\":0,\"task_digest\":\"78263a604bd9a456fd47f6b456ae2237ff1997840b9d2a3846baecfd1ad8eb25\"},\"max_age\":32,\"observed_sequence\":0,\"observed_variation\":\"0\",\"radius_now\":\"1/8388608\",\"receipt\":{\"bits\":24,\"boundary\":\"3/8\",\"epoch\":0,\"identity\":\"workflow-success\",\"mode\":\"compiled\",\"q\":\"3/4\",\"radius\":\"1/8388608\",\"residual\":\"1/33554432\",\"revision\":0,\"schema\":\"t2-receipt-v1\",\"sequence\":0,\"steps\":128,\"task\":[[{\"boundary\":\"1/8\",\"reward\":\"1/8\",\"weights\":[\"1/2\",\"1/4\"]},{\"boundary\":\"1/4\",\"reward\":\"1/8\",\"weights\":[\"1/4\",\"1/4\"]}],[{\"boundary\":\"1/8\",\"reward\":\"1/4\",\"weights\":[\"1/4\",\"1/4\"]},{\"boundary\":\"1/2\",\"reward\":\"1/8\",\"weights\":[\"1/8\",\"1/4\"]}]],\"task_digest\":\"78263a604bd9a456fd47f6b456ae2237ff1997840b9d2a3846baecfd1ad8eb25\",\"tick\":0,\"values\":[\"5452595/8388608\",\"2569011/4194304\"],\"variation\":\"0\"},\"receipt_digest\":\"348b33525d811853b5260c54f029721f20de8f234fd5dc17993a7ae06ae639e3\",\"schema\":\"t2-publication-v1\",\"status\":\"certified\",\"tolerance\":\"1/1000\"}");
atom pending = Record[ObjectLink]("pending",component,value);
}
