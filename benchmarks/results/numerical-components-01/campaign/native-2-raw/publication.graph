program {
rule publish {
atom publish_zero = Nat(); rank publish_rank = publish_zero;
mode publish_mode = ModeObject; revision publish_version; active publish_enabled;
atom publish_p = Constructor("T2Component");
atom publish_v = PatternVariable[Constructor] Free;
atom publish_pending = Record[ObjectLink]("pending",publish_p,publish_v);
atom publish_done = Record[ObjectLink]("uncertified",publish_p,publish_v);
lhs { publish_lhs0: publish_p; publish_lhs1: publish_v; publish_lhs2: publish_pending; } rhs { publish_rhs0: publish_p; publish_rhs1: publish_v; publish_rhs2: publish_done; }
}
atom component = Constructor("T2Component");
atom value = Constructor("{\"assumptions\":[\"complete sampled input stream\",\"protected task and host checker\",\"serialized host calls\",\"logical clock\",\"checked native CLI\"],\"checked_at\":1,\"current\":{\"active\":true,\"boundary\":\"5/8\",\"epoch\":0,\"fault\":null,\"revision\":0,\"task_digest\":\"f53ec44edd46ded3dc4950808d31f961bea623c38508dd7f85b89938bac5f325\"},\"max_age\":32,\"observed_sequence\":1,\"observed_variation\":\"1/4\",\"radius_now\":\"10485779/83886080\",\"receipt\":{\"bits\":24,\"boundary\":\"3/8\",\"epoch\":0,\"identity\":\"workflow-2-0\",\"mode\":\"raw\",\"q\":\"3/4\",\"radius\":\"19/83886080\",\"residual\":\"19/335544320\",\"revision\":0,\"schema\":\"t2-receipt-v1\",\"sequence\":0,\"steps\":64,\"task\":[[{\"boundary\":\"9/32\",\"reward\":\"0\",\"weights\":[\"1/8\",\"1/8\"]},{\"boundary\":\"1/8\",\"reward\":\"5/16\",\"weights\":[\"1/8\",\"3/8\"]}],[{\"boundary\":\"1/16\",\"reward\":\"3/32\",\"weights\":[\"3/10\",\"9/20\"]},{\"boundary\":\"3/8\",\"reward\":\"3/32\",\"weights\":[\"3/26\",\"7/52\"]}]],\"task_digest\":\"f53ec44edd46ded3dc4950808d31f961bea623c38508dd7f85b89938bac5f325\",\"tick\":0,\"values\":[\"5496137/8388608\",\"9570475/16777216\"],\"variation\":\"0\"},\"receipt_digest\":\"3aaa30e59de537d2d3cb7718b28a707b67bb6963d66b115f408f2aaf38ae9920\",\"schema\":\"t2-publication-v1\",\"status\":\"uncertified\",\"tolerance\":\"1/1000\"}");
atom pending = Record[ObjectLink]("pending",component,value);
}
